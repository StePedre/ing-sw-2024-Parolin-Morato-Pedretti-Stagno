<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.stage.Screen?>
<AnchorPane fx:id="anchor4" prefHeight="${screenHeight}" prefWidth="${screenWidth}" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.View.Controller">
   <children>
      <VBox fx:id="vboxWaitStart" alignment="CENTER" layoutX="633.0" layoutY="284.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="startLabel" alignment="CENTER" text="Please, wait for other players to join">
               <font>
                  <Font name="Bookman Old Style" size="30.0" />
               </font>
            </Label>
            <Label fx:id="startLabel2" alignment="CENTER" text="Match can start when &quot;Let's play!&quot; button appears.">
               <font>
                  <Font name="Bookman Old Style" size="30.0" />
               </font>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </Label>
            <ProgressBar fx:id="waitingBar" prefHeight="28.0" prefWidth="302.0" style="-fx-accent: #4B0082;" styleClass="indeterminate-progress-bar">
               <VBox.margin>
                  <Insets top="50.0" />
               </VBox.margin>
            </ProgressBar>
            <Button fx:id="buttonStart" alignment="CENTER" disable="true" mnemonicParsing="false" style="-fx-background-color: #1560BD;" text="Let's play!" textFill="WHITE" visible="false">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
               <font>
                  <Font name="Bookman Old Style" size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
